    p_library: GDExtensionClassLibraryPtr,
    p_get_proc_address: GDExtensionInterfaceGetProcAddress,
) {
    library = p_library
    get_godot_version = cast(ExtensionInterfaceGetGodotVersion)p_get_proc_address("get_godot_version")
    get_godot_version2 = cast(ExtensionInterfaceGetGodotVersion2)p_get_proc_address("get_godot_version2")
    mem_alloc = cast(ExtensionInterfaceMemAlloc)p_get_proc_address("mem_alloc")
    mem_realloc = cast(ExtensionInterfaceMemRealloc)p_get_proc_address("mem_realloc")
    mem_free = cast(ExtensionInterfaceMemFree)p_get_proc_address("mem_free")
    mem_alloc2 = cast(ExtensionInterfaceMemAlloc2)p_get_proc_address("mem_alloc2")
    mem_realloc2 = cast(ExtensionInterfaceMemRealloc2)p_get_proc_address("mem_realloc2")
    mem_free2 = cast(ExtensionInterfaceMemFree2)p_get_proc_address("mem_free2")
    print_error = cast(ExtensionInterfacePrintError)p_get_proc_address("print_error")
    print_error_with_message = cast(ExtensionInterfacePrintErrorWithMessage)p_get_proc_address("print_error_with_message")
    print_warning = cast(ExtensionInterfacePrintWarning)p_get_proc_address("print_warning")
    print_warning_with_message = cast(ExtensionInterfacePrintWarningWithMessage)p_get_proc_address("print_warning_with_message")
