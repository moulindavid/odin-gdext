    p_setter: GDExtensionConstStringNamePtr,
    /**
     * A pointer to a StringName with the name of the getter method.
     */
    p_getter: GDExtensionConstStringNamePtr,
)
/**
 * Registers an indexed property on an extension class in the ClassDB.
 * Provided struct can be safely freed once the function returns.
 * @since 4.2
 */
ExtensionInterfaceClassdbRegisterExtensionClassPropertyIndexed :: #type proc "c" (
    /**
